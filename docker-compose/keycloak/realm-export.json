{
  "realm": "issuer",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "verifyEmail": false,
  "attributes": {
    "userProfileEnabled": "true"
  },
  "clients": [
    {
      "clientId": "issuer_api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "issuer-api-secret",
      "redirectUris": [
        "https://issuer.theaustraliahack.com/*",
        "http://localhost:7002/*"
      ],
      "webOrigins": [
        "https://issuer.theaustraliahack.com",
        "http://localhost:7002"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "pid-attributes"
      ]
    },
    {
      "clientId": "waltid_backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "wallet-api-secret",
      "redirectUris": [
        "https://wallet.theaustraliahack.com/wallet-api/auth/oidc-session",
        "http://localhost:7101/wallet-api/auth/oidc-session"
      ],
      "webOrigins": [
        "https://wallet.theaustraliahack.com",
        "http://localhost:7101"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "rp_theaustraliahack",
      "name": "RP Demo - The Australia Hack",
      "description": "OIDC Relying Party client for the rp.theaustraliahack.com demo apps (Next.js + Widget)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "rp-theaustraliahack-secret",
      "redirectUris": [
        "https://rp.theaustraliahack.com/api/auth/callback/keycloak",
        "https://rp.theaustraliahack.com/callback",
        "http://localhost:3000/api/auth/callback/keycloak",
        "http://localhost:7020/api/auth/callback/keycloak",
        "http://localhost:4000/callback"
      ],
      "webOrigins": [
        "https://rp.theaustraliahack.com",
        "http://localhost:3000",
        "http://localhost:7020",
        "http://localhost:4000"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "https://rp.theaustraliahack.com/*##http://localhost:3000/*##http://localhost:7020/*##http://localhost:4000/*"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "web-origins"
      ],
      "optionalClientScopes": [
        "kyc",
        "age_over_18",
        "age_over_21"
      ]
    },
    {
      "clientId": "auth-op",
      "name": "auth-op (custom OIDC OP)",
      "description": "Confidential OIDC client used by auth-op's \"employees\" realm to authenticate against Keycloak. Client secret must match EMPLOYEES_OIDC_SECRET in docker-compose/.env.local.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "auth-op-demo-secret",
      "redirectUris": [
        "https://auth-op.theaustraliahack.com/callback/oidc",
        "http://localhost:7005/callback/oidc"
      ],
      "webOrigins": [
        "https://auth-op.theaustraliahack.com",
        "http://localhost:7005"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "https://auth-op.theaustraliahack.com/*##http://localhost:7005/*"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "openid",
      "description": "OpenID Connect scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "OpenID Connect"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${profileScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${emailScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "boolean"
          }
        }
      ]
    },
    {
      "name": "kyc",
      "description": "Emits boolean kyc_verified. Mirrors auth-op's kyc scope.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Share your KYC status"
      },
      "protocolMappers": [
        {
          "name": "kyc_verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "kyc_verified",
            "claim.name": "kyc_verified",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "boolean"
          }
        }
      ]
    },
    {
      "name": "age_over_18",
      "description": "Age-gate 18+. Boolean user attribute (pre-computed; no compute-from-birthdate mapper in Keycloak 26 core).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Share whether you are 18 or older"
      },
      "protocolMappers": [
        {
          "name": "age_over_18",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "age_over_18",
            "claim.name": "age_over_18",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "boolean"
          }
        }
      ]
    },
    {
      "name": "age_over_21",
      "description": "Age-gate 21+. Same pre-computed boolean design as age_over_18.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Share whether you are 21 or older"
      },
      "protocolMappers": [
        {
          "name": "age_over_21",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "age_over_21",
            "claim.name": "age_over_21",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "boolean"
          }
        }
      ]
    },
    {
      "name": "pid-attributes",
      "description": "PID attributes for credential issuance",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "birthdate",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "birthdate",
            "claim.name": "birthdate",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "nationality",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "nationality",
            "claim.name": "nationality",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "resident_address",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "resident_address",
            "claim.name": "resident_address",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "resident_city",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "resident_city",
            "claim.name": "resident_city",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "resident_state",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "resident_state",
            "claim.name": "resident_state",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "resident_postal_code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "resident_postal_code",
            "claim.name": "resident_postal_code",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "resident_country",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "resident_country",
            "claim.name": "resident_country",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "gender",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "gender",
            "claim.name": "gender",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "birth_place",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "birth_place",
            "claim.name": "birth_place",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        },
        {
          "name": "document_number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "document_number",
            "claim.name": "document_number",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
