# Internal HTTPS for issuer - allows verifier-api2 to reach status list URLs
# Credentials embed https://issuer.theaustraliahack.com/... which resolves to caddy via network alias
issuer.theaustraliahack.com:443 {
    tls internal
    reverse_proxy http://issuer-api:{$ISSUER_API_PORT}
}

# Internal HTTPS for auth-op - OIDC Provider with realm discovery
# Public entry point for RPs (https://auth-op.theaustraliahack.com) serving
# /.well-known/openid-configuration and /login/realm/{id} flows.
auth-op.theaustraliahack.com:443 {
    tls internal
    reverse_proxy http://auth-op:{$AUTH_OP_PORT}
}

# Keycloak admin / OIDC (fronted by Cloudflare tunnel)
keycloak.theaustraliahack.com:443 {
    tls internal
    reverse_proxy http://keycloak:{$KEYCLOAK_PORT}
}

