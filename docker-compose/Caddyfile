{
	admin off
}

# Wallet API
:{$WALLET_BACKEND_PORT} {
    reverse_proxy http://wallet-api:{$WALLET_BACKEND_PORT}
}

# Issuer API
:{$ISSUER_API_PORT} {
    # CORS for portal admin UI
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type, Authorization, statusCallbackUri"

    @options method OPTIONS
    handle @options {
        respond 204
    }

    # Serve custom TSL XML for trust list import
    handle /tsl.xml {
        root * /etc/caddy/tsl
        file_server
    }

    # Rewrite RFC 8414 style well-known URLs to our path structure
    # EUDI wallet requests: /.well-known/openid-credential-issuer/draft13
    # Our server expects: /draft13/.well-known/openid-credential-issuer
    rewrite /.well-known/openid-credential-issuer/draft13 /draft13/.well-known/openid-credential-issuer
    rewrite /.well-known/openid-configuration/draft13 /draft13/.well-known/openid-configuration
    rewrite /.well-known/oauth-authorization-server/draft13 /draft13/.well-known/oauth-authorization-server
    # Rewrite root well-known to draft13 version for EUDI wallet compatibility
    rewrite /.well-known/openid-credential-issuer /draft13/.well-known/openid-credential-issuer

    # Rewrite tenant-specific well-known URLs (RFC 8615 compliance for EUDI wallets)
    # Wallet requests: /.well-known/openid-credential-issuer/issuers/{id}/draft13
    # Server expects:  /issuers/{id}/draft13/.well-known/openid-credential-issuer
    @tenant_wellknown path_regexp tenant ^/\.well-known/(openid-credential-issuer|openid-configuration|oauth-authorization-server)/issuers/([^/]+)/(.+)$
    rewrite @tenant_wellknown /issuers/{re.tenant.2}/{re.tenant.3}/.well-known/{re.tenant.1}

    reverse_proxy http://issuer-api:{$ISSUER_API_PORT} {
        header_down -Access-Control-Allow-Origin
        header_down -Access-Control-Allow-Methods
        header_down -Access-Control-Allow-Headers
        header_down -Access-Control-Allow-Credentials
    }
}

