VERSION_TAG=stable
# Images for ARM (eg. Apple Silicon) are only available with the `latest` tag

VERSION_OPA=1.4.2
VERSION_VAULT=1.19.3
VERSION_VC_REPO=latest

IMAGE_PREFIX=""
#IMAGE_PREFIX="docker.io/"

SERVICE_HOST=localhost
#SERVICE_HOST=host.docker.internal

WALLET_BACKEND_PORT=7001
ISSUER_API_PORT=7002
VERIFIER_API_PORT=7003
VERIFIER_API2_PORT=7004
DEMO_WALLET_FRONTEND_PORT=7101
WEB_PORTAL_PORT=7102
VC_REPO_PORT=7103
DEV_WALLET_FRONTEND_PORT=7104
VAULT_PORT=8200
OPA_SERVER_PORT=8181

#database
DB_NAME=waltid
DB_USERNAME=waltid
DB_PASSWORD=waltid

#sqlite
SQLITE_DB_DATA=data/data.db
#postgres
POSTGRES_DB_PORT=5433
POSTGRES_DB_HOST=postgres # compose service name
POSTGRES_DB_DATA=/waltid-wallet-api/data/
PG_ADMIN_PORT=8080
#mssql
MSSQL_DB_PORT=1433

#sqlite | postgres | mssql
DATABASE_ENGINE=postgres
#identity | identity,tse | identity,opa | services | identity,valkey | all
COMPOSE_PROFILES=identity

# External URLs (browser-facing, via ngrok)                                                                                                                                                                                                                 
ISSUER_EXTERNAL_HTTPS_URL=https://issuer.theaustraliahack.com                                        
VERIFIER_EXTERNAL_HTTPS_URL=https://verifier.theaustraliahack.com
VERIFIER2_EXTERNAL_HTTPS_URL=https://verifier2.theaustraliahack.com
WALLET_EXTERNAL_URL=https://wallet.theaustraliahack.com
PORTAL_EXTERNAL_URL=https://portal.theaustraliahack.com

# Public URLs for QR codes and wallet-facing requests (must be HTTPS FQDNs)
ISSUER_EXTERNAL_URL=https://issuer.theaustraliahack.com
VERIFIER_EXTERNAL_URL=https://verifier.theaustraliahack.com
VERIFIER2_EXTERNAL_URL=https://verifier2.theaustraliahack.com

VC_REPO_EXTERNAL_URL=https://vc-repo.theaustraliahack.com

# Verifier API2 signing configuration for EUDI wallet compatibility
NEXT_PUBLIC_VERIFIER2_CLIENT_ID=x509_san_dns:verifier2.theaustraliahack.com
NEXT_PUBLIC_VERIFIER2_SIGNING_KEY={"type":"jwk","jwk":{"kty":"EC","crv":"P-256","x":"1Z2eGpdQVfWkAQQmNv8oT-lMwbhsFxWTZmhAYFHR5wY","y":"tvX699C21qGEMq7zqjpEhqy2kPT8KInnbxlLZzeSXdo","d":"j6-GyxLnrDSQGCljc678kmrihQFa0GR92JZXHDEQX38"}}
NEXT_PUBLIC_VERIFIER2_

# Trust Lists
TRUST_LISTS_ENABLED=true
ETSI_LOTL_URL=https://issuer.theaustraliahack.com/admin/issuer/lotl.xml

# OpenID Federation (disabled by default, requires trust anchors)
OPENID_FEDERATION_ENABLED=false

# Issuer Registrar (disabled by default, enable for multi-tenant issuance)
ISSUER_REGISTRAR_ENABLED=true

# StatusList2021 Revocation Management (disabled by default)
STATUS_LISTS_ENABLED=true

# RP Registrar (disabled by default, enable for relying party onboarding)
RP_REGISTRAR_ENABLED=true

# Multi-Tenant Wallet Awareness (disabled by default, enable for MT issuer/verifier identity)
# Requires: ISSUER_REGISTRAR_ENABLED=true and/or RP_REGISTRAR_ENABLED=true for full experience
# Docs: docs/mt-wallet/README.md
MT_WALLET_ENABLED=true

# Registered RP ID for rp.theaustraliahack.com (from verifier-api2 RP Registrar)
RP_THEAUSTRALIAHACK_ID=a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d

# ==================================================
# Verify API (NEW - Feature Flagged)
# ==================================================
# DISABLED by default - must explicitly enable
VERIFY_API_ENABLED=true
VERIFY_API_PORT=7010
# External URL - browser-accessible URL for SDK loading
# Local: http://localhost:7010 | Production: https://verify-api.theaustraliahack.com
VERIFY_API_EXTERNAL_URL=https://verify-api.theaustraliahack.com

# Verify Portal - Admin UI for Verify API
VERIFY_PORTAL_PORT=7011
# Local: http://localhost:7011 | Production: https://verify-portal.theaustraliahack.com
VERIFY_PORTAL_EXTERNAL_URL=https://verify-portal.theaustraliahack.com

# RP Demo - Relying Party integration examples
# Only ONE demo can run at a time (widget or nextjs)
# Use --profile rp-widget-demo or --profile rp-nextjs-demo
RP_WIDGET_PORT=4000
RP_NEXTJS_PORT=7020
# Local: http://localhost:4000 | Production: https://rp.theaustraliahack.com
RP_EXTERNAL_URL=https://rp.theaustraliahack.com

# API key for RP demos to access Verify API (sandbox credentials)
VERIFY_API_KEY=vfy_test_sandbox_demo_key_12345678

# Keycloak (identity provider for credential issuance)
KEYCLOAK_PORT=8180
KEYCLOAK_EXTERNAL_URL=https://keycloak.theaustraliahack.com

# OIDC RP login for rp.theaustraliahack.com demo apps
# Point RP_KEYCLOAK_ISSUER at whichever OP is fronting the RP:
#   - Direct Keycloak: https://keycloak.theaustraliahack.com/realms/issuer
#   - auth-op broker:  https://auth-op.theaustraliahack.com
# The shared client secret is RP_THEAUSTRALIAHACK_SECRET (see auth-op section
# below); it must match the secret registered in the OP for `rp_theaustraliahack`.
RP_KEYCLOAK_CLIENT_ID=rp_theaustraliahack
RP_KEYCLOAK_ISSUER=https://keycloak.theaustraliahack.com/realms/issuer
# Rotate these before deploying publicly:
AUTH_SECRET=e0a1f9be781ad97a75dfba4d6dfc8ad9ba89e9cae0d818c1b6b8c755b078dea2
SESSION_SECRET=fde2e2cd62d5a902c5e14058d825d3a9d746673b4dd9a7f48be2507b08ca7899

# Issuer Registrar (multi-tenant issuance)
ISSUER_REGISTRAR_ENABLED=true

# ==================================================
# auth-op (custom OIDC Provider with realm discovery)
# ==================================================
# Drop-in replacement for Keycloak as the RP-facing OP.
# - "employees" realm delegates to Keycloak via OIDC
# - "citizens"  realm triggers OID4VP flow via verifier-api2
# External: https://auth-op.theaustraliahack.com | Local: http://localhost:7005
#
# Secret values below are PLACEHOLDERS. Generate real secrets and override
# in docker-compose/.env.local or via Doppler; never commit production
# values to this template.
AUTH_OP_PORT=7005
AUTH_OP_ISSUER=https://auth-op.theaustraliahack.com
# Cookie Secure flag — true for production behind HTTPS
AUTH_OP_COOKIE_SECURE=true
EMPLOYEES_OIDC_SECRET=replace-me-with-keycloak-client-secret-for-auth-op
# Shared client secret for `rp_theaustraliahack` — consumed by BOTH:
#   - Keycloak's realm-export.json (if RPs talk to Keycloak directly), and
#   - auth-op's clients.conf (if RPs talk to auth-op).
# RPs themselves pull this same value via KEYCLOAK_CLIENT_SECRET /
# AUTH_KEYCLOAK_SECRET inside the container (see docker-compose.yaml).
RP_THEAUSTRALIAHACK_SECRET=rp-theaustraliahack-secret
