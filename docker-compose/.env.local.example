# Local Environment Overrides
# Copy this file to .env.local and uncomment the settings you want to override.
# .env.local is gitignored and will not be committed.

# ============================================
# Payment Wallet Attestation (PWA) Feature
# ============================================
# PWA is DISABLED by default. To enable, uncomment the line below.
#
# When disabled (default):
#   - PaymentWalletAttestation credential type is NOT registered
#   - Token responses do NOT include authorization_details
#   - Zero impact on existing credential issuance flows
#
# When enabled:
#   - PaymentWalletAttestation credential type is available
#   - Token responses include authorization_details with credential_identifiers
#   - PSP adapter is used to resolve funding sources
#
# Uncomment to enable:
# PWA_ENABLED=true

# PSP Adapter type (only used when PWA_ENABLED=true):
# - "mock": Use MockPspAdapter for testing (default)
# - Fully qualified class name for production adapters (e.g., "com.example.MyPspAdapter")
# PWA_PSP_ADAPTER=mock

# ============================================
# Feature Flags
# ============================================
# All feature flags default to false. Uncomment to enable.

# Issuer Registrar — multi-tenant credential issuance
# ISSUER_REGISTRAR_ENABLED=true

# Status Lists — credential revocation management
# STATUS_LISTS_ENABLED=true

# RP Registrar — multi-tenant relying party onboarding
# RP_REGISTRAR_ENABLED=true

# Multi-Tenant Wallet — issuer/verifier identity display in wallet
# MT_WALLET_ENABLED=true

# Trust Lists — ETSI trust list validation (verifier + wallet)
# TRUST_LISTS_ENABLED=true

# OpenID Federation — trust source via entity statement chains
# OPENID_FEDERATION_ENABLED=true

# Verify API — standalone verification service
# VERIFY_API_ENABLED=true

# ============================================
